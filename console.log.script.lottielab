// ─── LOTTIELAB CLIPBOARD INSPECTOR ───────────────────────────────────────────

// 1. COPY listener — fires when YOU copy something in the editor
document.addEventListener('copy', (e) => {
  console.group('%c📋 COPY EVENT', 'color: #4ade80; font-weight: bold; font-size: 14px');
  
  const items = e.clipboardData.items;
  const types = e.clipboardData.types;
  
  console.log('%cAvailable types:', 'color: #facc15', [...types]);
  
  for (const type of types) {
    const data = e.clipboardData.getData(type);
    console.group(`%c▶ type: "${type}"`, 'color: #60a5fa');
    console.log('raw length:', data.length);
    console.log('raw value:', data);
    
    // Try to parse as HTML and extract all attributes
    if (type === 'text/html') {
      try {
        const doc = new DOMParser().parseFromString(data, 'text/html');
        const allElements = doc.body.querySelectorAll('*');
        console.log('%cParsed HTML elements:', 'color: #a78bfa', allElements.length);
        allElements.forEach(el => {
          const attrs = [...el.attributes];
          if (attrs.length > 0) {
            console.log(`  <${el.tagName.toLowerCase()}>`, Object.fromEntries(attrs.map(a => [a.name, a.value.length > 100 ? a.value.slice(0, 100) + '...' : a.value])));
          }
          // Try base64 decode on every attribute value
          attrs.forEach(attr => {
            try {
              const decoded = atob(attr.value);
              console.log(`  %c🔓 base64 decoded attr "${attr.name}":`, 'color: #f97316', decoded.slice(0, 200));
              // Try JSON parse
              try {
                const json = JSON.parse(decoded);
                console.log(`  %c✅ parsed as JSON:`, 'color: #4ade80', json);
              } catch {}
            } catch {}
          });
        });
      } catch(err) {
        console.warn('HTML parse failed:', err);
      }
    }
    
    // Try to JSON parse plain text directly
    if (type === 'text/plain') {
      try {
        const json = JSON.parse(data);
        console.log('%c✅ text/plain is valid JSON:', 'color: #4ade80', json);
      } catch {}
      // Try base64 decode
      try {
        const decoded = atob(data);
        console.log('%c🔓 text/plain base64 decoded:', 'color: #f97316', decoded.slice(0, 200));
      } catch {}
    }
    
    console.groupEnd();
  }
  
  // Also dump items (may reveal custom MIME types not in types[])
  console.group('%cclipboardData.items:', 'color: #e879f9');
  for (const item of items) {
    console.log(`kind: "${item.kind}", type: "${item.type}"`);
    if (item.kind === 'string') {
      item.getAsString(s => {
        console.log(`  → string value (${s.length} chars):`, s.slice(0, 300));
      });
    }
  }
  console.groupEnd();
  
  console.groupEnd();
}, true); // true = capture phase, runs before app handlers


// 2. PASTE listener — fires when YOU paste into the editor
document.addEventListener('paste', (e) => {
  console.group('%c📌 PASTE EVENT', 'color: #f87171; font-weight: bold; font-size: 14px');
  
  const types = e.clipboardData.types;
  console.log('%cAvailable types:', 'color: #facc15', [...types]);
  
  for (const type of types) {
    const data = e.clipboardData.getData(type);
    console.group(`%c▶ type: "${type}"`, 'color: #60a5fa');
    console.log('raw length:', data.length);
    
    if (type === 'text/html') {
      try {
        const doc = new DOMParser().parseFromString(data, 'text/html');
        const allElements = doc.body.querySelectorAll('*');
        allElements.forEach(el => {
          const attrs = [...el.attributes];
          if (attrs.length > 0) {
            console.log(`<${el.tagName.toLowerCase()}>`, Object.fromEntries(attrs.map(a => [a.name, a.value])));
          }
          attrs.forEach(attr => {
            try {
              const decoded = atob(attr.value);
              console.log(`%c🔓 base64 decoded "${attr.name}":`, 'color: #f97316', decoded.slice(0, 500));
              try { console.log('%c✅ JSON:', 'color: #4ade80', JSON.parse(decoded)); } catch {}
            } catch {}
          });
        });
      } catch {}
    } else {
      console.log('value:', data.slice(0, 500));
    }
    console.groupEnd();
  }
  
  console.groupEnd();
}, true);


// 3. KEYDOWN sniffer — catch Cmd+C / Cmd+V before anything else
document.addEventListener('keydown', (e) => {
  if ((e.metaKey || e.ctrlKey) && (e.key === 'c' || e.key === 'v' || e.key === 'x')) {
    console.log(`%c⌨️  ${e.key.toUpperCase()} pressed`, 'color: #94a3b8; font-size: 11px', '— active element:', document.activeElement);
  }
}, true);


console.log('%c✅ Clipboard inspector active. Now copy/paste something in the editor.', 
  'color: #4ade80; font-weight: bold; padding: 4px 8px; background: #052e16; border-radius: 4px');
